# Supabase / PostgreSQL (shared pooler)
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.ygcutttsudzgepolnpqg
DATABASE_PASSWORD=

# Clerk (Dashboard → API Keys / JWT)
# Publishable key is safe for the browser auth page only — never put the secret key here for client use.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated authorized parties (azp). Include the auth page origin.
CLERK_AUTHORIZED_PARTIES=http://localhost:8080

# Server
SERVER_PORT=8080
