# Supabase / PostgreSQL (shared pooler)
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.ygcutttsudzgepolnpqg
DATABASE_PASSWORD=

# Clerk (Dashboard → API Keys / JWT)
# Publishable key is safe for the browser auth page only — never put the secret key here for client use.
CLERK_PUBLISHABLE_KEY=
# Server-only. Required for session token refresh via Clerk Backend API. Never expose to Unity.
CLERK_SECRET_KEY=
# IMPORTANT: The issuer and JWKS URL must match the Clerk instance encoded in
# your publishable key. Base64-decode the key payload (after pk_test_ / pk_live_)
# to find the instance domain, e.g. "nice-mite-1975.clerk.accounts.dev".
# A mismatch here causes every valid JWT to be rejected with HTTP 401.
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated authorized parties (azp). Include the auth page origin.
# Local: http://localhost:8080
# After Render deploy: also add https://YOUR_SERVICE.onrender.com
CLERK_AUTHORIZED_PARTIES=http://localhost:8080
# Unity game-client Clerk JWT lifetime (seconds).
# Default application behavior: 60 seconds (Clerk standard).
# Local MVP development recommendation: 3600 seconds (1 hour) to avoid frequent
# "session timed out" during gameplay. Production should use a shorter value.
CLERK_GAME_TOKEN_TTL_SECONDS=3600

# Server
# Local development uses SERVER_PORT. Render injects PORT automatically.
SERVER_PORT=8080

# Gemini AI Advisor
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Unity client / build-time public configuration (NOT secrets)
# Synced into Assets/Resources/BackendConfig.asset by Unity Editor tooling.
# Standalone players never read this file — values are baked at build time.
# UIU_BACKEND_MODE: LOCAL | REMOTE
# REMOTE builds fail if UIU_REMOTE_BACKEND_URL is empty, not HTTPS, or still
# the placeholder below.
# ---------------------------------------------------------------------------
UIU_BACKEND_MODE=LOCAL
UIU_LOCAL_BACKEND_URL=http://localhost:8080
UIU_REMOTE_BACKEND_URL=__RENDER_BACKEND_URL_NOT_CONFIGURED__
