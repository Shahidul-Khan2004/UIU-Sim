%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ba7a30d5b43537da2c76517d585d811, type: 3}
  m_Name: Faculty_Senior_02_Projects
  m_EditorClassIdentifier: Assembly-CSharp::UIU.Simulator.Gameplay.NPC.StudentDialogueTree
  treeId: faculty_senior_projects
  topic: "Senior asks a faculty member about projects"
  npcType: 1
  requirements:
    playerRole: 1
    department: 0
    semester: 0
    minDay: 1
    maxDay: 0
    requiredCourseId: ""
    assessmentDay: 0
  startNodeId: start
  closingPlayerLine: ""
  nodes:
  - id: start
    npcLine: "Good afternoon, {honorific}. I don't think we've met. Are you teaching this trimester?"
    choices:
    - playerLine: "Yes, in the {department} department."
      npcReaction: "Oh nice, {honorific}! {department} has a great group of students."
      nextNodeId: focus
  - id: focus
    npcLine: "What area do you focus on, {honorific}, if you don't mind me asking?"
    choices:
    - playerLine: "Mostly foundational courses."
      npcReaction: "Those shape everything that comes after, {honorific}."
      nextNodeId: projects
    - playerLine: "I'm interested in research."
      npcReaction: "That's exciting, {honorific}. Some of us are looking for research experience."
      nextNodeId: projects
    - playerLine: "A bit of everything for now."
      npcReaction: "Flexible, {honorific}. That's useful here."
      nextNodeId: projects
  - id: projects
    npcLine: "Would you ever take seniors on small projects, {honorific}?"
    choices:
    - playerLine: "Possibly, if they're committed."
      npcReaction: "I'll remember that, {honorific}."
      nextNodeId: examples
    - playerLine: "Not this trimester."
      npcReaction: "Understood, {honorific}. Maybe later."
      nextNodeId: examples
    - playerLine: "Come by during consultation hours."
      npcReaction: "I will, {honorific}. Thank you!"
      nextNodeId: examples
  - id: examples
    npcLine: "One thing seniors wish we'd had earlier, {honorific}: theory connected to real examples."
    choices:
    - playerLine: "Good point. I'll keep that in mind."
      npcReaction: "Thank you for listening, {honorific}."
      nextNodeId: settling
    - playerLine: "Do you have an example?"
      npcReaction: "When a teacher showed us a real app built on what we learned, it finally clicked, {honorific}."
      nextNodeId: settling
    - playerLine: "That's exactly what I plan to do."
      npcReaction: "Then your students are lucky, {honorific}."
      nextNodeId: settling
  - id: settling
    npcLine: "Anyway, {honorific}, how are you settling in?"
    choices:
    - playerLine: "Quite well, thanks."
      npcReaction: "Glad to hear it, {honorific}."
      nextNodeId: end
    - playerLine: "Still learning the routine."
      npcReaction: "It takes a week or two, {honorific}."
      nextNodeId: end
    - playerLine: "The campus is bigger than I expected."
      npcReaction: "It is, {honorific}. Take the stairs for short trips."
      nextNodeId: end
  - id: end
    npcLine: "I'll let you go, {honorific}. Welcome to UIU!"
    choices: []
