%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ba7a30d5b43537da2c76517d585d811, type: 3}
  m_Name: Batchmate_05_IcsDiscussion
  m_EditorClassIdentifier: Assembly-CSharp::UIU.Simulator.Gameplay.NPC.StudentDialogueTree
  treeId: batchmate_ics_discussion
  topic: "ICS discussion"
  npcType: 0
  requirements:
    playerRole: 0
    department: 1
    semester: 1
    minDay: 1
    maxDay: 0
    requiredCourseId: "ICS"
    assessmentDay: 0
  startNodeId: start
  closingPlayerLine: ""
  nodes:
  - id: start
    npcLine: "You're in {course} too, right? I think I saw you in the room."
    choices:
    - playerLine: "Yeah, I'm taking {course} this trimester."
      npcReaction: "Nice! Then you know exactly what I'm about to talk about."
      nextNodeId: finding
  - id: finding
    npcLine: "How are you finding {course}?"
    choices:
    - playerLine: "It's interesting."
      npcReaction: "Glad someone thinks so. The logic part is fun once it clicks."
      nextNodeId: coding
    - playerLine: "It's harder than I expected."
      npcReaction: "Same. It looked simple in the course outline."
      nextNodeId: coding
    - playerLine: "I'm still getting used to it."
      npcReaction: "Honestly, that's where most of us are."
      nextNodeId: coding
  - id: coding
    npcLine: "Had you done any programming before this?"
    choices:
    - playerLine: "A little, from online videos."
      npcReaction: "That's already a head start."
      nextNodeId: pace
    - playerLine: "Nothing at all."
      npcReaction: "Same here. Everyone starts somewhere."
      nextNodeId: pace
    - playerLine: "Quite a bit, actually."
      npcReaction: "Okay, you're my new study partner then."
      nextNodeId: pace
  - id: pace
    npcLine: "What do you think about the class pace?"
    choices:
    - playerLine: "It's fine if I review after class."
      npcReaction: "Reviewing the same day really helps, I noticed."
      nextNodeId: review
    - playerLine: "It moves too fast for me."
      npcReaction: "Ask questions early. Nobody minds, I promise."
      nextNodeId: review
    - playerLine: "A bit slow, honestly."
      npcReaction: "Enjoy it while it lasts. It speeds up."
      nextNodeId: review
  - id: review
    npcLine: "Are you practicing {course} outside class?"
    choices:
    - playerLine: "Yes, a little every day."
      npcReaction: "Look at you, being responsible."
      nextNodeId: end
    - playerLine: "Only before assessments."
      npcReaction: "Risky. The topics build on each other."
      nextNodeId: end
    - playerLine: "Not yet, honestly."
      npcReaction: "Try one small problem a day. It adds up."
      nextNodeId: end
  - id: end
    npcLine: "Okay, see you in the next {course} class. Sit near me if you want."
    choices: []
