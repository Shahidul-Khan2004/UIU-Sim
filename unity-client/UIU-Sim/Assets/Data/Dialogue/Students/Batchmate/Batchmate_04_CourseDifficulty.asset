%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ba7a30d5b43537da2c76517d585d811, type: 3}
  m_Name: Batchmate_04_CourseDifficulty
  m_EditorClassIdentifier: Assembly-CSharp::UIU.Simulator.Gameplay.NPC.StudentDialogueTree
  treeId: batchmate_course_difficulty
  topic: "Course difficulty"
  npcType: 0
  requirements:
    playerRole: 0
    department: 0
    semester: 1
    minDay: 1
    maxDay: 0
    requiredCourseId: ""
    assessmentDay: 0
  startNodeId: start
  closingPlayerLine: ""
  nodes:
  - id: start
    npcLine: "How are the courses treating you so far?"
    choices:
    - playerLine: "Pretty good, actually."
      npcReaction: "Lucky! I hope it stays that way."
      nextNodeId: workload
    - playerLine: "Still adjusting."
      npcReaction: "Yeah, the pace is really different from college."
      nextNodeId: workload
    - playerLine: "It's harder than I expected."
      npcReaction: "You're not the only one. I felt that on day one."
      nextNodeId: workload
  - id: workload
    npcLine: "What's the workload like in {department} for you?"
    choices:
    - playerLine: "Manageable if I keep up."
      npcReaction: "Keeping up is the whole trick, I think."
      nextNodeId: trimester
    - playerLine: "Heavier than I thought."
      npcReaction: "Everyone says the first few weeks feel heavy."
      nextNodeId: trimester
    - playerLine: "I haven't really started studying yet."
      npcReaction: "Ha, the classic. The first quiz will fix that."
      nextNodeId: trimester
  - id: trimester
    npcLine: "At least it's only our {trimester} trimester. Nobody expects us to be experts yet, right?"
    choices:
    - playerLine: "Right, it's only my {trimester} trimester."
      npcReaction: "Exactly. We're allowed to be confused for a bit."
      nextNodeId: notes
  - id: notes
    npcLine: "Do you take notes on paper or on your laptop?"
    choices:
    - playerLine: "Paper. I remember things better."
      npcReaction: "Old school. Teachers seem to like that."
      nextNodeId: help
    - playerLine: "Laptop. I type faster than I write."
      npcReaction: "Just don't open other tabs in class."
      nextNodeId: help
    - playerLine: "I take photos of the board."
      npcReaction: "Ha, a gallery full of whiteboards. Classic."
      nextNodeId: help
  - id: help
    npcLine: "If you get stuck on something, who do you go to?"
    choices:
    - playerLine: "The faculty, during consultation hours."
      npcReaction: "Good idea. Most of them are happy to help."
      nextNodeId: end
    - playerLine: "Seniors. They've done it all before."
      npcReaction: "Seniors are a cheat code, honestly."
      nextNodeId: end
    - playerLine: "Online tutorials, mostly."
      npcReaction: "Same. Some of those channels are lifesavers."
      nextNodeId: end
  - id: end
    npcLine: "Alright, I'm off to class. Let's survive this together."
    choices: []
