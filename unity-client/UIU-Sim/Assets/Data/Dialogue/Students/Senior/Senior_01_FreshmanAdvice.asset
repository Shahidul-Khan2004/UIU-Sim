%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ba7a30d5b43537da2c76517d585d811, type: 3}
  m_Name: Senior_01_FreshmanAdvice
  m_EditorClassIdentifier: Assembly-CSharp::UIU.Simulator.Gameplay.NPC.StudentDialogueTree
  treeId: senior_freshman_advice
  topic: "Freshman advice"
  npcType: 1
  requirements:
    playerRole: 0
    department: 0
    semester: 1
    minDay: 1
    maxDay: 0
    requiredCourseId: ""
    assessmentDay: 0
  startNodeId: start
  closingPlayerLine: ""
  nodes:
  - id: start
    npcLine: "Hey, you look like a fresher. First trimester?"
    choices:
    - playerLine: "Yeah, I'm in my {trimester} trimester."
      npcReaction: "Thought so. I remember that lost look. Welcome to UIU!"
      nextNodeId: week
  - id: week
    npcLine: "How has the first week been treating you?"
    choices:
    - playerLine: "Good, everyone's been friendly."
      npcReaction: "Glad to hear it. People here are mostly nice."
      nextNodeId: advice
    - playerLine: "Confusing, honestly."
      npcReaction: "That's normal. It clicks after a couple of weeks."
      nextNodeId: advice
    - playerLine: "Busy. Lots to figure out."
      npcReaction: "It settles down. The first month is the hardest."
      nextNodeId: advice
  - id: advice
    npcLine: "Want one piece of advice nobody gave me?"
    choices:
    - playerLine: "Please, go ahead."
      npcReaction: "Attend every class, even the boring ones. Attendance marks add up."
      nextNodeId: faculty
    - playerLine: "Only if it's short."
      npcReaction: "Fine: never skip classes. That's it."
      nextNodeId: faculty
    - playerLine: "Is it about CGPA?"
      npcReaction: "Kind of. Go to class. Attendance and quizzes quietly save your CGPA."
      nextNodeId: faculty
  - id: faculty
    npcLine: "Have you talked to any of your faculty members yet?"
    choices:
    - playerLine: "Not yet, they seem busy."
      npcReaction: "They have consultation hours. Use them, seriously."
      nextNodeId: friends
    - playerLine: "Yes, one of them was really helpful."
      npcReaction: "Good. Keep that connection."
      nextNodeId: friends
    - playerLine: "I'm a bit scared to."
      npcReaction: "Don't be. They like students who ask questions."
      nextNodeId: friends
  - id: friends
    npcLine: "Last thing: make friends in your section. Trust me on that one."
    choices:
    - playerLine: "I'm working on it."
      npcReaction: "Good. Study groups before quizzes are gold."
      nextNodeId: end
    - playerLine: "I already found a couple."
      npcReaction: "Perfect. Keep them close during exam season."
      nextNodeId: end
    - playerLine: "Why does it matter so much?"
      npcReaction: "Because someone has to share notes when you're sick."
      nextNodeId: end
  - id: end
    npcLine: "Alright, I've got a class. Good luck, and don't stress too much!"
    choices: []
